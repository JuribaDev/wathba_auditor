{
  "name": "agent-skills",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "prepare": "husky",
    "generate:skills": "tsx scripts/generate-skills.ts",
    "generate:plugin-dist": "pnpm generate:skills && tsx scripts/generate-plugin-dist.ts",
    "verify:skills:versions": "tsx scripts/verify-skill-versions.ts",
    "verify:skills:drift": "pnpm generate:skills && tsx scripts/check-generated-drift.ts",
    "verify:skills:freshness": "tsx scripts/check-compliance-freshness.ts",
    "verify:skills": "pnpm verify:skills:versions && pnpm verify:skills:freshness && pnpm verify:skills:drift",
    "verify:plugin-dist": "pnpm generate:plugin-dist && tsx scripts/check-plugin-dist-drift.ts",
    "dev": "pnpm generate:skills && pnpm --filter @agent-skills/web dev",
    "build": "pnpm generate:skills && pnpm --filter @agent-skills/web build",
    "lint": "pnpm --filter @agent-skills/web lint",
    "doctor:react": "pnpm --filter @agent-skills/web doctor:react",
    "typecheck": "pnpm generate:skills && pnpm --filter @agent-skills/skill-schema typecheck && pnpm --filter @agent-skills/web typecheck",
    "test": "pnpm generate:skills && pnpm --filter @agent-skills/web test",
    "test:e2e": "pnpm generate:skills && pnpm --filter @agent-skills/web test:e2e",
    "verify": "pnpm verify:skills && pnpm verify:plugin-dist && pnpm doctor:react && pnpm --filter @agent-skills/skill-schema typecheck && pnpm --filter @agent-skills/web typecheck && pnpm --filter @agent-skills/web test && pnpm --filter @agent-skills/web build",
    "verify:full": "pnpm verify && pnpm --filter @agent-skills/web test:e2e"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "zod": "^4.1.12"
  }
}
